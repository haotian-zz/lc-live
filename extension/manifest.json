{
  "manifest_version": 3,
  "name": "lc-live: LeetCode Java live compile errors",
  "version": "0.1.0",
  "description": "Shows javac errors inline in the LeetCode editor as you type, using a local compile server.",
  "minimum_chrome_version": "111",
  "permissions": ["storage"],
  "host_permissions": ["http://127.0.0.1/*", "http://localhost/*"],
  "background": { "service_worker": "background.js" },
  "action": { "default_popup": "popup.html", "default_title": "lc-live" },
  "content_scripts": [
    {
      "matches": ["https://leetcode.com/*", "https://leetcode.cn/*"],
      "js": ["inject.js"],
      "world": "MAIN",
      "run_at": "document_idle"
    },
    {
      "matches": ["https://leetcode.com/*", "https://leetcode.cn/*"],
      "js": ["bridge.js"],
      "world": "ISOLATED",
      "run_at": "document_idle"
    }
  ]
}
